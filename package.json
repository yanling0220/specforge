{
  "name": "specforge",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "sf": "node apps/cli/src/main.ts",
    "server": "node apps/server/src/main.ts",
    "web:build": "npm run build -w @specforge/web",
    "web:dev": "npm run dev -w @specforge/web",
    "web:e2e": "node apps/web/e2e/console.e2e.mjs",
    "web:e2e:projects": "node apps/web/e2e/projects.e2e.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0"
  }
}
